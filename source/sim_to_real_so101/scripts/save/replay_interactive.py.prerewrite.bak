        for path in ["/CameraOverhead", "/World/CameraOverhead",
                     "/Replicator/CameraOverhead"]:
            p = stage.GetPrimAtPath(path)
            if p.IsValid():
                cam_prim = p
                break
        if cam_prim is None:
            for prim in stage.Traverse():
                if prim.GetTypeName() == "Camera" and "Overhead" in prim.GetName():
                    cam_prim = prim
                    break
        if cam_prim is None:
            print("[WARNING]: CameraOverhead prim not found — listing Camera prims:")
            for prim in stage.Traverse():
                if prim.GetTypeName() == "Camera":
                    print(f"  {prim.GetPath()}")
            return

        print(f"[INFO]: Found CameraOverhead at {cam_prim.GetPath()}")

        # ── 3. Move camera to mat centre — translate op ONLY, keep rotation ────
        xformable = UsdGeom.Xformable(cam_prim)
        ops = xformable.GetOrderedXformOps()

        translate_op = None
        for op in ops:
            if op.GetOpType() == UsdGeom.XformOp.TypeTranslate:
                translate_op = op
                break

        if translate_op is not None:
            translate_op.Set(Gf.Vec3d(CAM_X, CAM_Y, CAM_Z))
            print(f"[INFO]: Translate updated to ({CAM_X},{CAM_Y},{CAM_Z}) — rotation preserved")
        else:
            # No translate op yet — add one; rotation ops (if any) remain
            xformable.AddTranslateOp().Set(Gf.Vec3d(CAM_X, CAM_Y, CAM_Z))
            print(f"[INFO]: Translate added ({CAM_X},{CAM_Y},{CAM_Z}) — rotation unchanged")

        # ── 4. Widen FOV ───────────────────────────────────────────────────────
        cam_schema = UsdGeom.Camera(cam_prim)
        cam_schema.GetFocalLengthAttr().Set(FOCAL_MM)
        cam_schema.GetHorizontalApertureAttr().Set(APERTURE_MM)
        print(f"[INFO]: FOV focal={FOCAL_MM}mm aperture={APERTURE_MM}mm (~83 deg H)")

        # ── 5. Switch active viewport to CameraOverhead ────────────────────────
        vp = get_active_viewport()
        if vp is not None:
            vp.camera_path = cam_prim.GetPath()
            print(f"[INFO]: Viewport → {cam_prim.GetPath()}")

        print("[INFO]: Expected: robot TOP, cylinder BOTTOM-LEFT, cup TOP-RIGHT")

    except Exception as e:
        print(f"[WARNING]: set_viewport_camera failed: {e}")
        import traceback; traceback.print_exc()

