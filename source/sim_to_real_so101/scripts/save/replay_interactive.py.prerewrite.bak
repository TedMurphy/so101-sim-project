"""Interactive camera-alignment viewer (WebRTC streaming).

1. Run this script with ./isaaclab.sh -p
2. Open your browser to http://localhost:8211/streaming/webrtc-demo/
3. Orbit the viewport to match the real overhead camera angle.
4. Press PLAY (▶) in the toolbar — the episode replays and auto-resets.
5. When the angle looks right:
     Create > Camera > Camera From View
   then read Translate XYZ / Orient XYZ from the Property panel.
6. Ctrl-C in the terminal to quit.
"""

import argparse
import os
from isaaclab.app import AppLauncher

parser = argparse.ArgumentParser(description="Interactive camera-alignment viewer.")
parser.add_argument("--task",         type=str, default="Lerobot-So101-Teleop-Cylinder-To-Target")
parser.add_argument("--real_repo_id", type=str, default="Screener2/V4_pnp_44_20260720_141907")
parser.add_argument("--episode",      type=int, default=0)
AppLauncher.add_app_launcher_args(parser)

import sys  # noqa: E402
# Read --episode from the real command line; keep required sim flags
_ep = 0
for _i, _a in enumerate(sys.argv[1:], 1):
    if _a == '--episode' and _i < len(sys.argv):
        _ep = int(sys.argv[_i + 1]) if _i + 1 < len(sys.argv) else 0
args_cli = parser.parse_args([
    '--livestream', '2', '--episode', str(_ep),
    '--kit_args',
    '--ext-folder /home/ted/isaac-sim/extsDeprecated --enable isaacsim.core.utils',
])
args_cli.enable_cameras = True
args_cli.device = 'cpu'

app_launcher   = AppLauncher(args_cli)
simulation_app = app_launcher.app

import torch
import gymnasium as gym
import pandas as pd
import isaaclab_tasks                           # noqa: F401
from isaaclab_tasks.utils import parse_env_cfg
import sim_to_real_so101.tasks                  # noqa: F401
from sim_to_real_so101.utils.lerobot_interface import LeRobotSO101Interface


def set_viewport_camera():
    """Set up cameras for sim-vs-real comparison.

    CameraOverhead position: above mat centre so vertical margins are equal.
    Rotation: NOT changed — the scene's existing orientation is correct.
    FOV: tuned so the full mat fills ~87% of horizontal width.

    Perspective camera is restored to its original position on every run.

    Tuning knobs (top of this function):
      CAM_Z       — raise to zoom out (see more), lower to zoom in
      APERTURE_MM — increase to widen FOV (zoom out), decrease to narrow
      CAM_X       — shift camera fore/aft along mat (0.20 = mat centre)
    """
    # ── Camera position (translate only — rotation left as-is) ────────────────
#    CAM_X = 0.20     # m — mat depth centre (robot at 0.0, far edge at 0.40)
    CAM_X = 0.20     # m — mat depth centre (robot at 0.0, far edge at 0.40)
#    CAM_Y = -0.004   # m — mat lateral centre
    CAM_Y = -0.004   # m — mat lateral centre
    CAM_Z = 0.55     # m — height above mat

    # ── FOV ───────────────────────────────────────────────────────────────────
    # focal=14.5mm, aperture=25mm → half-angle≈40.7° → H-FOV≈83°
    # At 0.55m height: mat half-width 38cm → 34.5° → 85% of half-FOV ✓
    FOCAL_MM    = 14.5
    APERTURE_MM = 25.0   # increase to zoom out, decrease to zoom in

    # ── Original Perspective camera position ──────────────────────────────────
    PERSP_EYE    = (-0.45, 0.001, 0.70)
    PERSP_TARGET = ( 0.22, 0.001, 0.035)

    try:
        from pxr import Gf, UsdGeom
        import omni.usd
        from omni.kit.viewport.utility import get_active_viewport

        stage = omni.usd.get_context().get_stage()

        # ── 1. Restore Perspective camera ──────────────────────────────────────
        try:
            from omni.kit.viewport.utility.camera_state import ViewportCameraState
            persp = ViewportCameraState("/OmniverseKit_Persp")
            persp.set_position_world(Gf.Vec3d(*PERSP_EYE),    True)
            persp.set_target_world(  Gf.Vec3d(*PERSP_TARGET), True)
            print(f"[INFO]: Perspective camera restored to eye={PERSP_EYE}")
        except Exception as pe:
            print(f"[WARNING]: Could not restore Perspective camera: {pe}")

        # ── 2. Find the CameraOverhead prim ────────────────────────────────────
        cam_prim = None
        for path in ["/CameraOverhead", "/World/CameraOverhead",
                     "/Replicator/CameraOverhead"]:
            p = stage.GetPrimAtPath(path)
            if p.IsValid():
                cam_prim = p
                break
        if cam_prim is None:
            for prim in stage.Traverse():
                if prim.GetTypeName() == "Camera" and "Overhead" in prim.GetName():
                    cam_prim = prim
                    break
        if cam_prim is None:
            print("[WARNING]: CameraOverhead prim not found — listing Camera prims:")
            for prim in stage.Traverse():
                if prim.GetTypeName() == "Camera":
                    print(f"  {prim.GetPath()}")
            return

        print(f"[INFO]: Found CameraOverhead at {cam_prim.GetPath()}")

        # ── 3. Move camera to mat centre — translate op ONLY, keep rotation ────
        xformable = UsdGeom.Xformable(cam_prim)
        ops = xformable.GetOrderedXformOps()

        translate_op = None
        for op in ops:
            if op.GetOpType() == UsdGeom.XformOp.TypeTranslate:
                translate_op = op
                break

        if translate_op is not None:
            translate_op.Set(Gf.Vec3d(CAM_X, CAM_Y, CAM_Z))
            print(f"[INFO]: Translate updated to ({CAM_X},{CAM_Y},{CAM_Z}) — rotation preserved")
        else:
            # No translate op yet — add one; rotation ops (if any) remain
            xformable.AddTranslateOp().Set(Gf.Vec3d(CAM_X, CAM_Y, CAM_Z))
            print(f"[INFO]: Translate added ({CAM_X},{CAM_Y},{CAM_Z}) — rotation unchanged")

        # ── 4. Widen FOV ───────────────────────────────────────────────────────
        cam_schema = UsdGeom.Camera(cam_prim)
        cam_schema.GetFocalLengthAttr().Set(FOCAL_MM)
        cam_schema.GetHorizontalApertureAttr().Set(APERTURE_MM)
        print(f"[INFO]: FOV focal={FOCAL_MM}mm aperture={APERTURE_MM}mm (~83 deg H)")

        # ── 5. Switch active viewport to CameraOverhead ────────────────────────
        vp = get_active_viewport()
        if vp is not None:
            vp.camera_path = cam_prim.GetPath()
            print(f"[INFO]: Viewport → {cam_prim.GetPath()}")

        print("[INFO]: Expected: robot TOP, cylinder BOTTOM-LEFT, cup TOP-RIGHT")

    except Exception as e:
        print(f"[WARNING]: set_viewport_camera failed: {e}")
        import traceback; traceback.print_exc()

#    CAM_X = 0.20     # m — mat depth centre (robot at 0.0, far edge at 0.40)
    CAM_X = 0.60     # m — mat depth centre (robot at 0.0, far edge at 0.40)
#    CAM_Y = -0.004   # m — mat lateral centre
    CAM_Y = -0.004   # m — mat lateral centre
    CAM_Z = 0.55     # m — height above mat

    # ── FOV ───────────────────────────────────────────────────────────────────
    # focal=14.5mm, aperture=25mm → half-angle≈40.7° → H-FOV≈83°
    # At 0.55m height: mat half-width 38cm → 34.5° → 85% of half-FOV ✓
